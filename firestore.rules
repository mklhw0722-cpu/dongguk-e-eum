rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수: 요청자가 인증되어 있는지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 헬퍼 함수: 요청자가 '승인된(approved)' 회원인지 검증
    function isApprovedUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    // 헬퍼 함수: 요청자가 '승인된 관리자(admin)'인지 검증
    function isApprovedAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==============================================================
    // 1. 회원 프로필 및 가입 신청 정보 (users 컬렉션)
    // ==============================================================
    match /users/{userId} {
      // 본인은 자신의 프로필을 언제든 읽을 수 있고(승인 대기 상태 확인용),
      // 승인된 정회원은 대화 상대 검색을 위해 승인된 회원의 프로필을 조회할 수 있으며,
      // 관리자는 모든 회원의 가입 신청서를 조회할 수 있습니다.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || isApprovedAdmin()
        || (isApprovedUser() && resource.data.approvalStatus == 'approved')
      );

      // [회원가입 및 생성 규칙]
      // 1) 일반 회원가입: 본인 UID로만 문서를 만들 수 있으며, 승인 상태는 'pending', 역할은 학생/동문/교수만 가능
      // 2) 최초 관리자 생성: 아직 관리자가 없거나, admin_bootstrap 등록자인 경우 관리자로 직접 생성 가능
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && (
                      (
                        request.resource.data.approvalStatus == 'pending'
                        && request.resource.data.role in ['student', 'alumni', 'professor']
                      )
                      || (
                        !exists(/databases/$(database)/documents/system/admin_bootstrap)
                        || (
                          exists(/databases/$(database)/documents/system/admin_bootstrap)
                          && get(/databases/$(database)/documents/system/admin_bootstrap).data.adminUid == request.auth.uid
                        )
                      )
                    );

      // [프로필 수정 규칙]
      // 1) 승인된 최고 관리자는 회원의 승인 상태(approvalStatus), 역할(role), 코멘트 변경 가능
      // 2) 최초 관리자 부트스트랩: 시스템 미등록 시 또는 admin_bootstrap 등록자 본인인 경우 승격 허용
      // 3) 일반 회원은 본인의 프로필만 수정 가능하며, 핵심 보호 필드(승인상태, 역할, 이메일, UID, 가입일)는 절대 임의 변경 불가!
      allow update: if isAuthenticated() && (
        isApprovedAdmin()
        || (
          request.auth.uid == userId
          && (
            !exists(/databases/$(database)/documents/system/admin_bootstrap)
            || (
              exists(/databases/$(database)/documents/system/admin_bootstrap)
              && get(/databases/$(database)/documents/system/admin_bootstrap).data.adminUid == request.auth.uid
            )
          )
        )
        || (
          // 본인 수정: 승인 상태·역할·UID·이메일·관리자 코멘트는 바꿀 수 없음
          // (필드가 원래 없던 문서도 안전하게 비교하도록 diff 사용 — 기존보다 완화하지 않음)
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['approvalStatus', 'role', 'uid', 'id', 'email', 'adminComment'])
        )
      );

      // 회원 탈퇴 또는 관리자 삭제
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isApprovedAdmin());
    }

    // ==============================================================
    // 1-1. 채팅용 공개 프로필 (publicProfiles 컬렉션 - 개인정보 최소화)
    // ==============================================================
    match /publicProfiles/{userId} {
      // 승인된 정회원 및 관리자만 공개 프로필 목록을 조회할 수 있습니다.
      allow read: if isApprovedUser() || isApprovedAdmin();

      // 본인 또는 관리자만 공개 프로필을 생성/수정할 수 있습니다.
      allow write: if isApprovedAdmin()
                   || (isApprovedUser() && request.auth.uid == userId);
    }

    // ==============================================================
    // 2. 최초 관리자 안전 생성 문서 (system 컬렉션)
    // ==============================================================
    match /system/admin_bootstrap {
      // 인증된 사용자 누구나 최초 관리자 설정 여부를 조회할 수 있습니다.
      allow read: if isAuthenticated();

      // 아직 최초 관리자가 등록되지 않은 상태(!exists)일 때만 최초 1회 등록을 허용합니다.
      // 이미 등록된 후에는 기존 관리자만 수정 가능합니다.
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/system/admin_bootstrap);
      allow update: if isAuthenticated() && resource.data.adminUid == request.auth.uid;
      allow delete: if false;
    }

    match /system/notice_sync_status {
      // 승인된 정회원만 공식 공지 동기화 상태(마지막 수집 성공 시각 등)를 조회할 수 있습니다.
      allow read: if isApprovedUser();
      // 오직 승인된 관리자만 동기화 상태를 기록/갱신할 수 있습니다.
      allow write: if isApprovedAdmin();
    }

    // ==============================================================
    // 3. 학우들이 쓴 글 (communityPosts 컬렉션 - 내부 콘텐츠 보호)
    // ==============================================================
    match /communityPosts/{postId} {
      // [내부 콘텐츠 보호 핵심 원칙]
      // 관리자 승인을 받은(approved) 회원만 게시글을 읽을 수 있습니다.
      // 미승인(pending/rejected) 및 비로그인 상태에서는 데이터베이스 접근 자체가 원천 차단됩니다.
      allow read: if isApprovedUser();

      // [새 글 쓰기] 승인된 회원만 글을 등록할 수 있으며, 작성자 ID가 본인과 일치해야 합니다.
      allow create: if isApprovedUser()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 1
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 1
                    && request.resource.data.content.size() <= 5000;

      // [댓글/공감 달기] 승인된 회원만 가능하며, 원본 제목과 본문은 수정 불가합니다.
      allow update: if isApprovedUser()
                    && request.resource.data.title == resource.data.title
                    && request.resource.data.content == resource.data.content
                    && request.resource.data.authorId == resource.data.authorId;

      // [삭제] 작성자 본인이거나 승인된 관리자만 삭제할 수 있습니다.
      allow delete: if isApprovedUser() && (
        resource.data.authorId == request.auth.uid
        || isApprovedAdmin()
      );
    }

    // ==============================================================
    // 4. 대화창 (chats 컬렉션 - 참여자 전용 보호)
    // ==============================================================
    match /chats/{chatId} {
      // 승인된 회원 중 대화 참여자(participants) 또는 승인된 관리자만 열람/작성 가능
      allow read: if isApprovedUser() && (
        request.auth.uid in resource.data.participants
        || isApprovedAdmin()
      );
      allow create: if isApprovedUser() && request.auth.uid in request.resource.data.participants;
      allow update: if isApprovedUser() && (
        request.auth.uid in resource.data.participants
        || isApprovedAdmin()
      );

      // 메시지 하위 컬렉션
      match /messages/{messageId} {
        allow read: if isApprovedUser() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          || isApprovedAdmin()
        );
        allow create: if isApprovedUser()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if isApprovedUser() && (
          resource.data.senderId == request.auth.uid
          || isApprovedAdmin()
        );
      }
    }

    // ==============================================================
    // 5. 개인별 졸업요건 기록 (graduationRecords 컬렉션 - 개인정보 보호)
    // ==============================================================
    match /graduationRecords/{userId} {
      // 오직 본인(userId) 또는 승인된 관리자만 조회 및 수정 가능
      allow read, write: if isApprovedUser() && (
        request.auth.uid == userId
        || isApprovedAdmin()
      );
    }

    // ==============================================================
    // 6. 학교·교육학과·사범대학 공지사항 (notices 컬렉션 - 공식 연동 & 학과 공지)
    // ==============================================================
    match /notices/{noticeId} {
      // 승인된 정회원(approved)만 내부 공지사항을 조회할 수 있습니다 (비로그인/미승인 차단)
      allow read: if isApprovedUser();

      // 일반 사용자는 공지를 등록·수정·삭제할 수 없으며, 오직 승인된 관리자(isApprovedAdmin)만 가능합니다.
      allow create, update, delete: if isApprovedAdmin();
    }

    // 그 외 지정되지 않은 모든 컬렉션과 문서는 전면 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
