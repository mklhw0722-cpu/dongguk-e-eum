rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 헬퍼 함수: 요청자가 인증되어 있는지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 헬퍼 함수: 요청자가 '승인된(approved)' 회원인지 검증
    function isApprovedUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved';
    }

    // 헬퍼 함수: 요청자가 '승인된 관리자(admin)'인지 검증
    function isApprovedAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==============================================================
    // 1. 회원 프로필 및 가입 신청 정보 (users 컬렉션)
    // ==============================================================
    match /users/{userId} {
      // 본인은 자신의 프로필을 언제든 읽을 수 있고(승인 대기 상태 확인용),
      // 관리자는 모든 회원의 가입 신청서를 조회할 수 있습니다.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isApprovedAdmin());

      // [회원가입 및 생성 규칙]
      // 1) 일반 회원가입: 본인 UID로만 문서를 만들 수 있으며, 승인 상태는 'pending', 역할은 학생/동문/교수만 가능
      // 2) 최초 관리자 생성: 아직 관리자가 없거나, admin_bootstrap 등록자인 경우 관리자로 직접 생성 가능
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && (
                      (
                        request.resource.data.approvalStatus == 'pending'
                        && request.resource.data.role in ['student', 'alumni', 'professor']
                      )
                      || (
                        !exists(/databases/$(database)/documents/system/admin_bootstrap)
                        || (
                          exists(/databases/$(database)/documents/system/admin_bootstrap)
                          && get(/databases/$(database)/documents/system/admin_bootstrap).data.adminUid == request.auth.uid
                        )
                      )
                    );

      // [프로필 수정 규칙]
      // 1) 승인된 관리자는 모든 회원의 승인 상태(approvalStatus)와 역할(role)을 변경할 수 있습니다.
      // 2) 최초 관리자 부트스트랩: 아직 시스템에 관리자가 없거나, admin_bootstrap의 adminUid가 본인인 경우 관리자 승격 허용
      // 3) 일반 회원은 본인의 bio 등만 수정 가능 (스스로 승인상태/역할 변경 불가)
      allow update: if isAuthenticated() && (
        isApprovedAdmin()
        || (
          request.auth.uid == userId
          && (
            !exists(/databases/$(database)/documents/system/admin_bootstrap)
            || (
              exists(/databases/$(database)/documents/system/admin_bootstrap)
              && get(/databases/$(database)/documents/system/admin_bootstrap).data.adminUid == request.auth.uid
            )
          )
        )
        || (
          request.auth.uid == userId
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.role == resource.data.role
        )
      );

      // 회원 탈퇴 또는 관리자 삭제
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isApprovedAdmin());
    }

    // ==============================================================
    // 2. 최초 관리자 안전 생성 문서 (system 컬렉션)
    // ==============================================================
    match /system/admin_bootstrap {
      // 인증된 사용자 누구나 최초 관리자 설정 여부를 조회할 수 있습니다.
      allow read: if isAuthenticated();

      // 아직 최초 관리자가 등록되지 않은 상태(!exists)일 때만 최초 1회 등록을 허용합니다.
      // 이미 등록된 후에는 기존 관리자만 수정 가능합니다.
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/system/admin_bootstrap);
      allow update: if isAuthenticated() && resource.data.adminUid == request.auth.uid;
    }

    // ==============================================================
    // 3. 학우들이 쓴 글 (communityPosts 컬렉션 - 내부 콘텐츠 보호)
    // ==============================================================
    match /communityPosts/{postId} {
      // [내부 콘텐츠 보호 핵심 원칙]
      // 관리자 승인을 받은(approved) 회원만 게시글을 읽을 수 있습니다.
      // 미승인(pending) 상태에서는 데이터베이스 접근 자체가 원천 차단됩니다.
      allow read: if isApprovedUser();

      // [새 글 쓰기] 승인된 회원만 글을 등록할 수 있습니다.
      allow create: if isApprovedUser()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 1
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 1
                    && request.resource.data.content.size() <= 5000;

      // [댓글/공감 달기] 승인된 회원만 가능하며, 원본 제목과 본문은 수정 불가합니다.
      allow update: if isApprovedUser()
                    && request.resource.data.title == resource.data.title
                    && request.resource.data.content == resource.data.content
                    && request.resource.data.authorId == resource.data.authorId;

      // [삭제] 작성자 본인이거나 승인된 관리자만 삭제할 수 있습니다.
      allow delete: if isApprovedUser() && (
        request.resource.data.authorId == request.auth.uid
        || resource.data.authorId == request.auth.uid
        || isApprovedAdmin()
      );
    }

    // 그 외 지정되지 않은 모든 컬렉션은 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
